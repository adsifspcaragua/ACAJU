generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model ADM {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  pass      String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admlog    ADMLOG[]
  news      News[]
  mutirao   Mutirao[]
  documents Document[]
  miniMuseu MiniMuseumItem[]
  projects  Project[]
  memories  Memory[]

  @@map("adm")
}

model ADMLOG {
  id        String   @id @default(uuid())
  action    String
  loginAt   DateTime @default(now())
  ipAddress String?
  userAgent String?

  adminId String
  ADM     ADM    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admlog")
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}

enum MutiraoType {
  LIMPEZA
  PLANTIO
  OUTRO
}

enum Environment {
  PRAIA
  RIO
  MANGUE
  RESTINGA
  URBANO
}

// (Tela Horário de Funcionamento)

enum VisitStatus {
  ABERTO
  FECHADO
  MANUTENCAO
}

// Modelo da Tabela de Horário de Funcionamento
model OperatingHours {
  id              String      @id @default(uuid())
  currentStatus   VisitStatus @default(ABERTO)
  openingTime     String
  closingTime     String
  additionalNotes String?     @db.Text
  updatedAt       DateTime    @updatedAt

  @@map("operatinghours")
}

// PUBLICAÇÕES 

model News {
  id         String  @id @default(uuid())
  title      String
  content    String  @db.Text
  coverImage String
  videoUrl   String?
  status     Status  @default(APPROVED)

  adminId String
  ADM     ADM    @relation(fields: [adminId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images NewsImage[]

  @@map("news")
}

// mini tabela para salvar url de image linha por linha
model NewsImage {
  id        String   @id @default(uuid())
  url       String
  createdAt DateTime @default(now())

  newsId String
  news   News   @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@map("newsimage")
}

// MULTIRÔES

model Mutirao {
  id          String      @id @default(uuid())
  name        String
  type        MutiraoType
  date        DateTime
  time        String
  location    String
  environment Environment
  coverImage  String
  description String      @db.Text
  createdAt   DateTime    @default(now())

  adminId String
  ADM     ADM    @relation(fields: [adminId], references: [id])

  @@map("mutirao")
}

model Project {
  id          String   @id @default(uuid())
  title       String
  coordinator String
  objective   String   @db.Text
  bodyContent String   @db.Text
  coverImage  String
  videoUrl    String?
  status      Status   @default(APPROVED)
  createdAt   DateTime @default(now())

  adminId String
  ADM     ADM    @relation(fields: [adminId], references: [id])

  images ProjectImage[]

  @@map("project")
}

model ProjectImage {
  id        String   @id @default(uuid())
  url       String
  createdAt DateTime @default(now())

  projectId String
  mutirao   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("projectimage")
}

model Memory {
  id         String   @id @default(uuid())
  title      String // Título / Figura Homenageada
  content    String   @db.Text
  coverImage String
  videoUrl   String?
  createdAt  DateTime @default(now())

  adminId String
  ADM     ADM    @relation(fields: [adminId], references: [id])

  memoryImages MemoryImage[]

  @@map("memory")
}

model MemoryImage {
  id        String   @id @default(uuid())
  url       String
  createdAt DateTime @default(now())

  memoryId String
  memory   Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@map("memoryimage")
}

model Document {
  id          String   @id @default(uuid())
  name        String
  description String   @db.Text
  fileUrl     String // URL do PDF upado
  createdAt   DateTime @default(now())

  adminId String
  ADM     ADM    @relation(fields: [adminId], references: [id])

  @@map("document")
}

