model MiniMuseumItem {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  imageUrl    String
  year        String?

  adminId String
  ADM     ADM    @relation(fields: [adminId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("minimuseumitem")
}